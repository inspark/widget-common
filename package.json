{
  "name": "widget-common-container",
  "version": "19.0.1",
  "scripts": {
    "clean": "rimraf dist",
    "build_full": "copy-files-from-to --config ./projects/widget-common/versions/full/copy.json && ng build",
    "build_interface": "copy-files-from-to --config ./projects/widget-common/versions/interfaces/copy.json && ng build",
    "build": "npm run clean && npm run build_full && npm run build_interface && copy-files-from-to --config ./projects/widget-common/copy.json --mode production && node update_full.js",
    "dev": "ng build --watch=true",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "publish": "npm publish dist/widget-common/"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "echarts": "^5.6.0",
    "js-cookie": "^3.0.5",
    "ng-inline-svg-2": "^20.0.1",
    "ngx-echarts": "^18.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.0.0",
    "rimraf": "^6.0.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/language-service": "^19.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@types/forge-viewer": "^7.69.9",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "copy-files-from-to": "^2.0.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^19.0.0",
    "rxjs": "~7.8.0",
    "sass": "^1.77.0",
    "ts-node": "^10.9.0",
    "tslib": "^2.6.0",
    "typescript": "~5.6.0"
  }
}
